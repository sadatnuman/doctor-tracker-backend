# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (include the database name, e.g. /doctor-tracker)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority

# Auth — use a long random string (e.g. `openssl rand -base64 48`). Must match the frontend's JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Short-lived access token (can't be revoked, so keep it short) and rotating refresh token.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins (the frontend URL)
CLIENT_ORIGIN=http://localhost:3000

# Set to true in production (HTTPS) so the auth cookies are marked Secure
COOKIE_SECURE=false

# Doctors' weekly schedules are written in this timezone
CLINIC_TIMEZONE=Asia/Dhaka
# Minutes a booked slot is held while the patient pays; unpaid holds release the slot
PAYMENT_HOLD_MINUTES=5

# Demo accounts created by `npm run seed`
SEED_ADMIN_EMAIL=admin@doctortracker.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DOCTOR_EMAIL=doctor@doctortracker.com
SEED_DOCTOR_PASSWORD=Doctor@12345
SEED_PATIENT_EMAIL=patient@doctortracker.com
SEED_PATIENT_PASSWORD=Patient@12345
