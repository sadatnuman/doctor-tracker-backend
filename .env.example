# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (include the database name, e.g. /doctor-tracker)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority

# Auth — use a long random string (e.g. `openssl rand -base64 48`). Must match the frontend's JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins (the frontend URL)
CLIENT_ORIGIN=http://localhost:3000

# Set to true in production (HTTPS) so the auth cookie is marked Secure
COOKIE_SECURE=false

# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@doctortracker.com
SEED_ADMIN_PASSWORD=Admin@12345
